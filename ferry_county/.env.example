DATABASE_URL=postgresql+psycopg2://ferry:ferry@127.0.0.1:5434/ferry

# Optional reference path for humans / scripts (not read by the server unless you use tooling)
FERRY_KMZ_PATH=/absolute/path/to/FerryCounty_Complete_Roads_v2.kmz

# --- Security (path-based /gis/import-kmz) ---
# Prefer POST /gis/import-kmz-upload. Path import is OFF by default.
ALLOW_KMZ_PATH_IMPORT=false
# Comma-separated absolute directory prefixes allowed when path import is on
KMZ_PATH_ALLOW_PREFIXES=

# --- Compliance tuning ---
MATCH_RATIO_REQUIRED=0.25
DAVIS_BACON_THRESHOLD_USD=2000

# --- Field PWA (CORS) — comma-separated origins; match Docker / Vite / prod URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Weather / SENTINEL (optional)
# NOAA Climate Data Online token (Palmer / long-lead drying). Leave empty to skip CDO fetches.
NOAA_CDO_TOKEN=
# GAIA atmospheric JSON bundle (tried first; then api.weather.gov). Override Railway default in config if needed.
GAIA_WEATHER_BUNDLE_URL=

# --- Attachment blob storage (local disk; Docker stack uses /data/ferry_attachments)
ATTACHMENT_STORAGE_DIR=data/ferry_attachments
# MAX_ATTACHMENT_BYTES=31457280
